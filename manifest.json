{
  "manifest_version": 3,
  "name": "Blush for Canvas",
  "version": "3.0.1",
  "description": "A dusty-pink, fast, accessible Canvas: quick jump, shortcuts, your own colors and fonts, a study timer with a garden and a pet, and a to-do panel that cheers you on.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://api.artic.edu/*",
    "https://www.artic.edu/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Blush for Canvas"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/*"],
      "css": ["styles/theme.css"],
      "js": [
        "shared/look.js",
        "content/sky.js",
        "shared/pets.js",
        "content/study.js",
        "content/settings.js",
        "content/canvas.js",
        "content/helpers.js",
        "content/panel.js",
        "content/stars.js",
        "content/declutter.js",
        "content/actions.js",
        "content/dock.js",
        "content/quick-jump.js",
        "content/help.js",
        "content/prefetch.js",
        "content/keyboard.js",
        "content/recents.js",
        "content/banner.js",
        "content/photos.js",
        "content/color-fixer.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/ui.css", "styles/study.css", "styles/stage.css", "fonts/*"],
      "matches": ["https://*.instructure.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
